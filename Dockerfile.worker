FROM python:3.11-slim
WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq-dev gcc ca-certificates wget xz-utils \
    && rm -rf /var/lib/apt/lists/*

# Debian's packaged ffmpeg is not guaranteed to include libvmaf — install a
# static build that explicitly bundles it, and fail the build if it doesn't.
RUN wget -q https://github.com/BtbN/FFmpeg-Builds/releases/download/latest/ffmpeg-master-latest-linux64-gpl.tar.xz \
    && tar -xf ffmpeg-master-latest-linux64-gpl.tar.xz \
    && mv ffmpeg-master-latest-linux64-gpl/bin/ffmpeg /usr/local/bin/ffmpeg \
    && mv ffmpeg-master-latest-linux64-gpl/bin/ffprobe /usr/local/bin/ffprobe \
    && rm -rf ffmpeg-master-latest-linux64-gpl* \
    && ffmpeg -hide_banner -filters | grep -q vmaf

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY . .

CMD ["celery", "-A", "celery_tasks", "worker", "--loglevel=info", "--concurrency=1"]
